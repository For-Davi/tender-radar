# Modelo das variáveis de ambiente. Copie para .env (o `make up` faz isso sozinho)
# e troque as senhas. O .env NUNCA é commitado (está no .gitignore).

# ---------- Aplicação ----------
APP_NAME=radar
# dev | test | prod
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = um JSON por linha (containers); false = texto legível (terminal)
LOG_JSON=false

# ---------- API ----------
# origens que o navegador pode usar para chamar a API (CORS), separadas por vírgula.
# "*" não é aceito: liste o endereço do frontend (esquema + host + porta)
CORS_ORIGINS=http://localhost:3000

# ---------- Frontend ----------
# endereço da API visto pelo NAVEGADOR; entra no JavaScript no build da imagem
# (mudou? rode make up de novo, que reconstrói o frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- PostgreSQL (camada silver/gold) ----------
# localhost para rodar a API fora do Docker; dentro do Compose a API usa "postgres"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=radar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=radar

# ---------- MongoDB (camada bronze) ----------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_ROOT_USER=radar
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_DB=radar_bronze

# ---------- RabbitMQ (mensageria) ----------
# o usuário padrão "guest" só aceita conexões de localhost, por isso criamos outro
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=radar
RABBITMQ_PASSWORD=troque-esta-senha

# ---------- API do PNCP ----------
PNCP_CONSULTA_URL=https://pncp.gov.br/api/consulta
PNCP_API_URL=https://pncp.gov.br/api/pncp
# a API de detalhes do PNCP às vezes leva ~30 s por resposta
PNCP_TIMEOUT_SECONDS=90
# tentativas por requisição (429/5xx/timeout); 4xx nunca é repetido
PNCP_MAX_ATTEMPTS=5
# intervalo mínimo entre requisições, em segundos (educação com a API pública)
PNCP_MIN_INTERVAL_SECONDS=0.2

# ---------- Ingestão ----------
# UFs e modalidades separadas por vírgula (6 = pregão eletrônico, 8 = dispensa)
INGESTAO_UFS=CE
INGESTAO_MODALIDADES=6,8
# janela móvel: últimos N dias (2 = ontem e hoje)
INGESTAO_JANELA_DIAS=2
INGESTAO_INTERVALO_MINUTOS=60
# onde os editais são gravados (no Docker: /data/editais, num volume)
STORAGE_DIR=storage/editais
# tamanho máximo de um documento baixado (30 MB)
DOCUMENTO_MAX_BYTES=31457280
