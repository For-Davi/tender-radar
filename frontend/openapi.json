{
  "openapi": "3.1.0",
  "info": {
    "title": "radar",
    "description": "\nContratações públicas do PNCP, limpas (camada silver) e analisadas (camada gold).\n\n- **Erros** seguem o formato `application/problem+json` (RFC 9457).\n- **Dinheiro** é enviado como texto decimal (`\"1234.5600\"`), nunca como float.\n- **Datas** de filtro são dias no horário de Brasília.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "infra"
        ],
        "summary": "Health",
        "description": "Usado pelo healthcheck do Docker e por monitores externos.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contratacoes": {
      "get": {
        "tags": [
          "contratações"
        ],
        "summary": "Listar Contratacoes",
        "description": "Lista contratações com filtros combináveis, paginação e ordenação.",
        "operationId": "listar_contratacoes_contratacoes_get",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Página desejada (1 = primeira)",
              "default": 1,
              "title": "Pagina"
            },
            "description": "Página desejada (1 = primeira)"
          },
          {
            "name": "tamanho_pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Itens por página",
              "default": 20,
              "title": "Tamanho Pagina"
            },
            "description": "Itens por página"
          },
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "Sigla da UF, ex.: CE"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Uf"
            }
          },
          {
            "name": "orgao",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "CNPJ do órgão, com ou sem máscara",
                  "examples": [
                    "07.954.480/0001-79"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "title": "Orgao"
            }
          },
          {
            "name": "categoria",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{2}$",
                  "description": "Capítulo NCM/NBS (2 dígitos). Valores em GET /categorias",
                  "examples": [
                    "30"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "title": "Categoria"
            }
          },
          {
            "name": "data_inicio",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Publicadas a partir deste dia",
              "title": "Data Inicio"
            },
            "description": "Publicadas a partir deste dia"
          },
          {
            "name": "data_fim",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Publicadas até este dia (inclusive)",
              "title": "Data Fim"
            },
            "description": "Publicadas até este dia (inclusive)"
          },
          {
            "name": "valor_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Valor total estimado mínimo",
              "title": "Valor Min"
            },
            "description": "Valor total estimado mínimo"
          },
          {
            "name": "valor_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Valor total estimado máximo",
              "title": "Valor Max"
            },
            "description": "Valor total estimado máximo"
          },
          {
            "name": "ordenar",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Ordenacao",
              "description": "`-` na frente = decrescente",
              "default": "-data_publicacao"
            },
            "description": "`-` na frente = decrescente"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaResponse_ContratacaoResponse_"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/contratacoes/{id}": {
      "get": {
        "tags": [
          "contratações"
        ],
        "summary": "Detalhar Contratacao",
        "description": "Detalhe de uma contratação, com o órgão e todos os itens (e o vencedor de cada um).",
        "operationId": "detalhar_contratacao_contratacoes__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9A-Z]{12}\\d{2}-1-\\d{6}-\\d{4}$",
              "description": "Número de controle PNCP com '-' no lugar de '/'",
              "examples": [
                "07954480000179-1-000123-2025"
              ],
              "title": "Id"
            },
            "description": "Número de controle PNCP com '-' no lugar de '/'"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContratacaoDetalheResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
