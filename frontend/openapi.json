  "components": {
    "schemas": {
      "CategoriaResponse": {
        "properties": {
          "material_ou_servico": {
            "$ref": "#/components/schemas/MaterialOuServico"
          },
          "ncm_capitulo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ncm Capitulo",
            "description": "Valor para o filtro `categoria`; null = sem classificação (não filtrável)"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          }
        },
        "type": "object",
        "required": [
          "material_ou_servico",
          "ncm_capitulo",
          "nome"
        ],
        "title": "CategoriaResponse"
      },
      "ContratacaoDetalheResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Id público: número de controle PNCP com '-' no lugar de '/'"
          },
          "numero_controle_pncp": {
            "type": "string",
            "title": "Numero Controle Pncp"
          },
          "orgao": {
            "$ref": "#/components/schemas/OrgaoRefResponse"
          },
          "modalidade": {
            "type": "integer",
            "title": "Modalidade"
          },
          "modalidade_nome": {
            "type": "string",
            "title": "Modalidade Nome"
          },
          "situacao": {
            "type": "integer",
            "title": "Situacao"
          },
          "situacao_nome": {
            "type": "string",
            "title": "Situacao Nome"
          },
          "objeto": {
            "type": "string",
            "title": "Objeto"
          },
          "valor_total_estimado": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valor Total Estimado",
            "description": "null = orçamento sigiloso"
          },
          "data_publicacao": {
            "type": "string",
            "format": "date-time",
            "title": "Data Publicacao"
          },
          "uf": {
            "type": "string",
            "title": "Uf"
          },
          "municipio": {
            "type": "string",
            "title": "Municipio"
          },
          "total_itens": {
            "type": "integer",
            "title": "Total Itens"
          },
          "itens": {
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            },
            "type": "array",
            "title": "Itens"
          }
        },
        "type": "object",
        "required": [
          "id",
          "numero_controle_pncp",
          "orgao",
          "modalidade",
          "modalidade_nome",
          "situacao",
          "situacao_nome",
          "objeto",
          "valor_total_estimado",
          "data_publicacao",
          "uf",
          "municipio",
          "total_itens",
          "itens"
        ],
        "title": "ContratacaoDetalheResponse"
      },
      "ContratacaoResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Id público: número de controle PNCP com '-' no lugar de '/'"
          },
          "numero_controle_pncp": {
            "type": "string",
            "title": "Numero Controle Pncp"
          },
          "orgao": {
            "$ref": "#/components/schemas/OrgaoRefResponse"
          },
          "modalidade": {
            "type": "integer",
            "title": "Modalidade"
          },
          "modalidade_nome": {
            "type": "string",
            "title": "Modalidade Nome"
          },
          "situacao": {
            "type": "integer",
            "title": "Situacao"
          },
          "situacao_nome": {
            "type": "string",
            "title": "Situacao Nome"
          },
          "objeto": {
            "type": "string",
            "title": "Objeto"
          },
          "valor_total_estimado": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valor Total Estimado",
            "description": "null = orçamento sigiloso"
          },
          "data_publicacao": {
            "type": "string",
            "format": "date-time",
            "title": "Data Publicacao"
          },
          "uf": {
            "type": "string",
            "title": "Uf"
          },
          "municipio": {
            "type": "string",
            "title": "Municipio"
          },
          "total_itens": {
            "type": "integer",
            "title": "Total Itens"
          }
        },
        "type": "object",
        "required": [
          "id",
          "numero_controle_pncp",
          "orgao",
          "modalidade",
          "modalidade_nome",
          "situacao",
          "situacao_nome",
          "objeto",
          "valor_total_estimado",
          "data_publicacao",
          "uf",
          "municipio",
          "total_itens"
        ],
        "title": "ContratacaoResponse"
      },
      "Esfera": {
        "type": "string",
        "enum": [
          "F",
          "E",
          "M",
          "D",
          "N"
        ],
        "title": "Esfera"
      },
      "FornecedorResponse": {
        "properties": {
          "documento": {
            "type": "string",
            "title": "Documento"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "tipo_pessoa": {
            "$ref": "#/components/schemas/TipoPessoa"
          },
          "tipo_pessoa_nome": {
            "type": "string",
            "title": "Tipo Pessoa Nome"
          }
        },
        "type": "object",
        "required": [
          "documento",
          "nome",
          "tipo_pessoa",
          "tipo_pessoa_nome"
        ],
        "title": "FornecedorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "ItemResponse": {
        "properties": {
          "numero_item": {
            "type": "integer",
            "title": "Numero Item"
          },
          "descricao": {
            "type": "string",
            "title": "Descricao"
          },
          "material_ou_servico": {
            "$ref": "#/components/schemas/MaterialOuServico"
          },
          "material_ou_servico_nome": {
            "type": "string",
            "title": "Material Ou Servico Nome"
